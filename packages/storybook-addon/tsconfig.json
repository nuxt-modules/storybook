{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": false,
    "moduleResolution": "Bundler",
    "paths": {
      "#app/*": ["./node_modules/nuxt/dist/app/*"],
      "#components": ["./types/nuxt-components.d.ts"],
      "#imports": ["./types/nuxt-imports.d.ts"]
    },
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["src/**/*"]
}
