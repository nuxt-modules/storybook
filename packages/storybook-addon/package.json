{
  "name": "@storybook-vue/nuxt",
  "version": "9.0.1",
  "description": "Storybook addon for Nuxt and Vite",
  "license": "MIT",
  "homepage": "https://storybook.nuxtjs.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/storybook.git",
    "directory": "packages/storybook-addon"
  },
  "bugs": {
    "url": "https://github.com/nuxt-modules/storybook/issues"
  },
  "keywords": [
    "storybook",
    "nuxt",
    "vite",
    "vue3"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./preview": {
      "types": "./dist/preview.d.mts",
      "import": "./dist/preview.mjs"
    },
    "./package.json": "./package.json"
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist/**/*",
    "template/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "test": "vitest run",
    "dev": "unbuild",
    "prepack": "unbuild",
    "release": "pnpm changelogen --release --push && pnpm publish"
  },
  "peerDependencies": {
    "nuxt": "^3.18.1 || ^4.0.0",
    "storybook": "^10.6.0",
    "vite": "^5.2.0 || ^6.0.0 || ^7.0.0 || ^8.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/vite-builder": "^4.0.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@storybook/builder-vite": "catalog:",
    "@storybook/vue3": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "json-stable-stringify": "^1.3.0",
    "mlly": "^1.8.0",
    "pathe": "^2.0.3",
    "unplugin": "^3.4.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@vitejs/plugin-vue": "^6.0.7",
    "changelogen": "catalog:",
    "nuxt": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vue": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
